# ==========================================
# UniScholar 环境变量配置模板
# ==========================================

# 通用大模型调用配置（支持 DeepSeek / 通义千问 / OpenAI 兼容格式）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_FORMAT=openai

# 中国联通元景万悟平台对接配置（预留生态接入）
YUANJING_API_KEY=
YUANJING_BASE_URL=https://yuanjing.unicom.cn/api/v1
YUANJING_MODEL=yuanjing-research-v2

# 特征提取与并发控制
LLM_EXTRACT_QPS=4
LLM_EXTRACT_WORKERS=8

# HuggingFace 镜像与离线模式
HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_OFFLINE=1  # 开启后不联网下载模型，使用本地缓存或BoW词频降级

# 评委无密钥离线演示模式 (1=开启, 0=关闭)
# OFFLINE_DEMO=1
